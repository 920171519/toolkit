# 新账号的默认部门。生产网页在构建前设置。admin:create 读取命令执行环境。
NEXT_PUBLIC_DEPARTMENT_NAME=软件工程部

# SQLite 数据库文件路径。默认：./data/toolkit.db
# DATABASE_PATH=./data/toolkit.db

# 验证报告的实际存放目录。默认：./data/uploads/reports
# TOOLKIT_REPORTS_PATH=./data/uploads/reports

# 未设置时根据 X-Forwarded-Proto 自动判断；HTTPS 反代可显式设为 true，HTTP 验收不要设为 true
# SESSION_COOKIE_SECURE=true

# 置为 1 时不写入演示数据。适合正式环境首次启动。
# TOOLKIT_SKIP_SEED=0
